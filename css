@import url('https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&family=Roboto:ital,wght@0,100..900;1,100..900&family=Ubuntu:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&display=swap');

@import url("https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css");

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Ubuntu', sans-serif;
    color: #1f2124;
}

.conteiner {
    width: 1440px;
    margin: 0 auto;
}

.titulo-secao{
    text-align: center;
    margin-bottom: 50px;
    font-size: 44px;
    font-weight: 700;
    color: #2d2d2d;
}


/* CABECALHO */
header  {

    background-image: linear-gradient(180deg, #D7D7D7E0 0%, #FFFFFF00 100%);

    width: 100%;
    height: 128px;

    display: flex;
    justify-content: center;
    align-items: center;

    position: sticky;
    top: 0;

}

header .menu {

    background-color: #fff;
    width: 96%;
    height: 85px;
    padding: 20px 50px;
    border-radius: 10px;

    display: flex;
}

header .menu .navegacao {
    list-style: none;

    flex-basis: 100%;
    display: flex;
    align-items: center;
    justify-content: space-around;

}

header .menu .navegacao a {
    text-decoration: none;
    color: #1f2124;
    font-weight: 500;

}

header .menu .navegacao .idiomas {
    display: flex;
    gap: 5px;
}

header .menu .navegacao .idiomas img {
    width: 25px;
}

/* VIDEO BANNER */

.video-banner {
    width: 100%;

    position: relative;
    margin-top: -40px;
    z-index: -1;
}

.video-banner video {
    width: 100%;
    height: 600px;
    object-fit: cover;
    display: block;
}

/* CONHEÇA O PARQUE */
.conheca-parque .conteiner {

    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: 10px;

    padding: 50px 0;
}

.conheca-parque .slogan {
    flex-basis: 50%;
}

.conheca-parque .slogan img {
    max-width: 100%;
}

.conheca-parque .texto {
    
    padding-top: 22px;

    flex-basis: 50%;
    font-size: 18px;
    font-weight: 300;
    line-height: 30px;
    color: #2d2d2d;
    
}

.conheca-parque .texto p {
    margin-bottom: 20px;
}

.conheca-parque .btn-conheca-parque {
    
    text-decoration: none;
    color: #ffffff;
    background-color: #1478bd;
    border-radius: 5px;
    font-size: 13px;
    padding: 15px 25px;
    font-weight: 500;
    transition: all  0.5s;

}

.conheca-parque .btn-conheca-parque:hover {

    background: #006627;
    box-shadow: 5px 5px 10px 0px #00000050  ;
    

}

/* BLOG */

.nosso-blog {
    background-color: #f9f9f9;
    padding: 50px 0 50px 0;
}

.nosso-blog .publicacoes {
    display: flex;
    flex-direction: row;
    gap: 50px;

}

.nosso-blog .publicacao {
    flex-basis: 33%;
    background-color: #fff;
    padding: 20px;
    border-radius: 15px;
    box-shadow: 0 0 10px #00000010;
}

.nosso-blog .publicacao img {
    max-width: 100%;
}

.nosso-blog h2 {
    font-size: 17px;
    
}
